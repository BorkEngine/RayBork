# RayBork M3 sample box: one static part named "body".
# Faces are counter-clockwise when viewed from outside the box.
g body
v -0.5 -0.5 -0.5
v 0.5 -0.5 -0.5
v 0.5 0.5 -0.5
v -0.5 0.5 -0.5
v -0.5 -0.5 0.5
v 0.5 -0.5 0.5
v 0.5 0.5 0.5
v -0.5 0.5 0.5
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 -1 0
f 5/1/1 6/2/1 7/3/1 8/4/1
f 1/1/2 4/2/2 3/3/2 2/4/2
f 2/1/3 3/2/3 7/3/3 6/4/3
f 1/1/4 5/2/4 8/3/4 4/4/4
f 4/1/5 8/2/5 7/3/5 3/4/5
f 1/1/6 2/2/6 6/3/6 5/4/6
