<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>true</PublishAot>
        <RenderTargetPackFileName Condition="'$(RenderTargetPackFileName)' == ''"
            >rendertarget.pck</RenderTargetPackFileName>
        <!-- Samples are documentation, not shipped API, so they are held to the recommended set. -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
    </PropertyGroup>

    <!-- The assets project lives inside this sample directory (flat per-sample layout). Keep its
         sources out of this project's default item globs; the solution builds that project separately. -->
    <ItemGroup>
        <Compile Remove="RenderTarget.Assets/**" />
        <None Remove="RenderTarget.Assets/**" />
    </ItemGroup>

    <!-- The solution's RenderTarget.Assets build writes the baked pack beside this executable. Record
         it as a build output so dotnet clean removes it. The path is evaluated after the SDK has set
         TargetDir. -->
    <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
        <FileWrites Include="$(TargetDir)$(RenderTargetPackFileName)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="PolyType" />
        <PackageReference Include="SDL3-CS" />
        <PackageReference Include="SDL3-CS.Native" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/RayBork/RayBork.Engine/RayBork.Engine.csproj" />
    </ItemGroup>

    <!--
        dotnet publish builds this project but not RenderTarget.Assets, so the pack comes from the
        Release solution build, where RenderTarget.Assets bakes it beside this executable. A missing
        pack is an error with the build command instead of a published host that cannot start.
    -->
    <Target
        Name="RenderTargetCopyPackToPublish"
        AfterTargets="Publish"
        Condition="'$(PublishDir)' != '' and '$(DesignTimeBuild)' != 'true'"
    >
        <PropertyGroup>
            <_RenderTargetSamplePackPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RenderTargetPackFileName)</_RenderTargetSamplePackPath>
        </PropertyGroup>
        <Error
            Condition="!Exists('$(_RenderTargetSamplePackPath)')"
            Text="RayBork RenderTarget sample: the baked pack '$(_RenderTargetSamplePackPath)' is missing. Build the RenderTarget solution in Release first: dotnet build samples/RenderTarget/RenderTarget.slnx -c Release. RenderTarget.Assets bakes $(RenderTargetPackFileName) beside the sample executable during that build."
        />
        <Copy
            SourceFiles="$(_RenderTargetSamplePackPath)"
            DestinationFolder="$(PublishDir)"
            SkipUnchangedFiles="true"
        />
    </Target>
</Project>
