<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The builder uses WithProjectRoot("."), so a direct `dotnet run` must start in this
             directory for the checked-in Assets/ sources to resolve. The sample build passes the
             project root and output root explicitly, so its bake is independent of the working
             directory. The output root still defaults to AppContext.BaseDirectory, which puts
             rendertarget.pck next to the assets executable for a direct run. -->
        <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
        <!-- Build-time tooling: this executable is JIT and must never enter a runtime publish graph. -->
        <PublishAot>false</PublishAot>
        <!-- Sample build tooling is not shipped API, so it is held to the recommended analyzer set. -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <RenderTargetPackFileName Condition="'$(RenderTargetPackFileName)' == ''">rendertarget.pck</RenderTargetPackFileName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\RayBork\RayBork.Bake\RayBork.Bake.csproj" />
    </ItemGroup>

    <!-- libshaderc is a JIT build-time dependency of the bake. The package's native asset lives
         under runtimes/<rid>/native, which is not on the native loader's search path for a net11.0
         tool; this shared target copies the pinned library beside the assets executable. -->
    <Import Project="..\..\..\build\RayBork.Shaderc.targets" />

    <!-- Record the generated pack as a build output so dotnet clean removes it. The path is under the
         intermediate output and is known after the SDK has set IntermediateOutputPath. -->
    <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
        <FileWrites Include="$(IntermediateOutputPath)rendertarget-pack\$(RenderTargetPackFileName)" />
    </ItemGroup>

    <!--
        The sample's bake step. The solution builds this executable, then it runs the bake out of
        process over the checked-in Assets/ sources. The pack is copied beside the sample executable
        so both a normal build and a later AOT publish can mount it, and the output-root pack stays
        under the intermediate output so dotnet clean removes it. Explicit project and output roots
        keep the bake independent of the working directory.
    -->
    <Target Name="RenderTargetBakeAssets"
            AfterTargets="Build"
            DependsOnTargets="RayBorkCopyShadercNative"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_RenderTargetPackDirectory>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)rendertarget-pack</_RenderTargetPackDirectory>
            <_RenderTargetPackPath>$(_RenderTargetPackDirectory)\$(RenderTargetPackFileName)</_RenderTargetPackPath>
            <_RenderTargetSamplePackDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\bin\$(Configuration)\$(TargetFramework)'))</_RenderTargetSamplePackDirectory>
        </PropertyGroup>
        <MakeDir Directories="$(_RenderTargetPackDirectory);$(_RenderTargetSamplePackDirectory)" />
        <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; bake --project-root &quot;$(MSBuildProjectDirectory)&quot; --output-root &quot;$(_RenderTargetPackDirectory)&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)"
              StandardOutputImportance="high"
              StandardErrorImportance="high" />
        <Error Condition="!Exists('$(_RenderTargetPackPath)')"
               Text="RayBork RenderTarget sample: the bake did not produce '$(_RenderTargetPackPath)'." />
        <Copy SourceFiles="$(_RenderTargetPackPath)" DestinationFolder="$(_RenderTargetSamplePackDirectory)" SkipUnchangedFiles="true" />
    </Target>

</Project>
