<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>true</PublishAot>
        <PongPackFileName Condition="'$(PongPackFileName)' == ''">pong.pck</PongPackFileName>
        <!-- Samples are documentation, not shipped API, so they are held to the recommended set. -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
    </PropertyGroup>

    <!-- The assets project lives inside this sample directory (flat per-sample layout). Keep its
         sources out of this project's default item globs; the solution builds that project separately. -->
    <ItemGroup>
        <Compile Remove="Pong.Assets/**" />
        <None Remove="Pong.Assets/**" />
    </ItemGroup>

    <!-- The solution's Pong.Assets build writes the baked pack beside this executable. Record it as a
         build output so dotnet clean removes it. The path is evaluated after the SDK has set TargetDir. -->
    <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
        <FileWrites Include="$(TargetDir)$(PongPackFileName)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="PolyType" />
        <PackageReference Include="SDL3-CS" />
        <PackageReference Include="SDL3-CS.Native" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/RayBork/RayBork.Engine/RayBork.Engine.csproj" />
    </ItemGroup>

    <!--
        dotnet publish builds this project but not Pong.Assets, so the pack comes from the Release
        solution build, where Pong.Assets bakes it beside this executable. A missing pack is an error
        with the build command instead of a published host that cannot start.
    -->
    <Target Name="PongCopyPackToPublish"
            AfterTargets="Publish"
            Condition="'$(PublishDir)' != '' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_PongSamplePackPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(PongPackFileName)</_PongSamplePackPath>
        </PropertyGroup>
        <Error Condition="!Exists('$(_PongSamplePackPath)')"
               Text="RayBork Pong sample: the baked pack '$(_PongSamplePackPath)' is missing. Build the Pong solution in Release first: dotnet build samples/Pong/Pong.slnx -c Release. Pong.Assets bakes $(PongPackFileName) beside the sample executable during that build." />
        <Copy SourceFiles="$(_PongSamplePackPath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
