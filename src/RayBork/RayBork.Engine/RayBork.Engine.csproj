<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>RayBork</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RayBork.Bake" />
        <InternalsVisibleTo Include="RayBork.Tests" />
        <!-- The build-only generator builds the internal asset descriptors in the built-in pack. -->
        <InternalsVisibleTo Include="RayBork.BuiltInAssets" />
    </ItemGroup>

    <ItemGroup>
        <!-- Committed SPIR-V blobs are build inputs; the runtime never runs glslc. -->
        <EmbeddedResource Include="Shaders\*.spv" LogicalName="RayBork.Shaders.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Vulkan" />
        <PackageReference Include="SDL3-CS" />
        <PackageReference Include="SDL3-CS.Native" />
        <PackageReference Include="PolyType" />
        <PackageReference Include="Nerdbank.MessagePack" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="ZLogger" />
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <!-- Build-time built-in asset pack -> embedded C#. The generator is JIT and build-only; the
         generated pack is compiled into this assembly, so the engine needs no pack file, tooling,
         shader compiler, or filesystem I/O at startup. -->
    <Import Project="..\..\..\build\RayBork.BuiltInAssets.targets" />

</Project>
