#include "SsaoAbi.glslinc"

// The N8AO 2.0 golden-angle hemisphere kernel, baked as constants. AO_SAMPLE_COUNT is a compile-time
// definition supplied by each variant, so the loop unrolls and no sample count is a runtime uniform.
const vec3 AO_KERNEL[64] = vec3[64](
    vec3(0.08838835, 0.00000000, 0.99608609),
    vec3(-0.11288607, 0.10341294, 0.98821177),
    vec3(0.01727894, -0.19688560, 0.98027420),
    vec3(0.14228574, 0.18558628, 0.97227182),
    vec3(-0.26111164, -0.04618672, 0.96420304),
    vec3(0.24734752, -0.15734264, 0.95606616),
    vec3(-0.08273254, 0.30776261, 0.94785943),
    vec3(-0.15778122, -0.30379695, 0.93958102),
    vec3(0.34232131, 0.12501448, 0.93122903),
    vec3(-0.35612774, 0.14700522, 0.92280144),
    vec3(0.17167641, -0.36686470, 0.91429618),
    vec3(0.12686614, 0.40446567, 0.90571105),
    vec3(-0.38237356, -0.22159188, 0.89704376),
    vec3(0.44856670, -0.09861753, 0.88829190),
    vec3(-0.27375220, 0.38938700, 0.87945295),
    vec3(-0.06324507, -0.48804463, 0.87052427),
    vec3(0.38825357, 0.32721808, 0.86150305),
    vec3(-0.52246589, 0.02160765, 0.85238636),
    vec3(0.38109726, -0.37924581, 0.84317110),
    vec3(-0.02549458, 0.55139598, 0.83385400),
    vec3(-0.36261875, -0.43453440, 0.82443162),
    vec3(0.57442535, 0.07728530, 0.81490030),
    vec3(-0.48670741, 0.33864199, 0.80525617),
    vec3(0.13299380, -0.59118538, 0.79549513),
    vec3(0.30761793, 0.53682745, 0.78561282),
    vec3(-0.60135894, -0.19184610, 0.77560460),
    vec3(0.58414100, -0.26989219, 0.76546554),
    vec3(-0.25306142, 0.60468787, 0.75519037),
    vec3(-0.22585913, -0.62793324, 0.74477346),
    vec3(0.60097826, 0.31585222, 0.73420876),
    vec3(-0.66753209, 0.17596424, 0.72348981),
    vec3(0.37942633, -0.59010436, 0.71260964),
    vec3(0.12070426, 0.70231260, 0.70156076),
    vec3(-0.57201117, -0.44299066, 0.69033506),
    vec3(0.73170146, -0.06062572, 0.67892378),
    vec3(-0.50575588, 0.54671610, 0.66731739),
    vec3(0.00367778, -0.75518142, 0.65550553),
    vec3(0.51430976, 0.56694177, 0.64347688),
    vec3(-0.77229549, -0.07156937, 0.63121906),
    vec3(0.62578305, -0.47495586, 0.61871843),
    vec3(-0.14237338, 0.78265083, 0.60595998),
    vec3(-0.42889036, -0.68153544, 0.59292706),
    vec3(0.78592221, 0.21538054, 0.57960116),
    vec3(-0.73348180, 0.37641990, 0.56596157),
    vec3(0.28985377, -0.78185503, 0.55198505),
    vec3(0.31791954, 0.78093832, 0.53764533),
    vec3(-0.77026778, -0.36503431, 0.52291252),
    vec3(0.82326056, -0.25382976, 0.50775240),
    vec3(-0.44014825, 0.75105394, 0.49212549),
    vec3(-0.18465292, -0.85984929, 0.47598582),
    vec3(0.72418326, 0.51441335, 0.45927933),
    vec3(-0.89015606, 0.11094903, 0.44194174),
    vec3(0.58704602, -0.68970245, 0.42389562),
    vec3(0.03333102, 0.91368843, 0.40504629),
    vec3(-0.64773511, -0.65726838, 0.38527588),
    vec3(0.93001473, 0.04754050, 0.36443449),
    vec3(-0.72431541, 0.59848114, 0.34232660),
    vec3(0.13096303, -0.93876844, 0.31868872),
    vec3(0.54221538, 0.78744205, 0.29315098),
    vec3(-0.93965195, -0.21619831, 0.26516504),
    vec3(0.84593014, -0.47928561, 0.23385359),
    vec3(-0.30247883, 0.93243984, 0.19764235),
    vec3(-0.41010990, -0.89909531, 0.15309311),
    vec3(0.91698150, 0.38901469, 0.08838835));

layout(location = 0) in vec2 vUv;
layout(location = 0) out vec4 oColor;

void main() {
    ivec2 size = ivec2(ssaoResolution());
    ivec2 pixel = clamp(ivec2(gl_FragCoord.xy), ivec2(0), size - ivec2(1));
    float depth = texelFetch(sceneDepth, pixel, 0).x;
    if (depth <= 0.0) {
        oColor = vec4(1.0, 0.5, 0.5, 1.0);
        return;
    }

    vec3 viewPosition = ssaoViewPosition(depth, vUv);
    vec3 normal = ssaoDepthNormal(viewPosition, vUv);
    vec4 noise = texture(blueNoise, gl_FragCoord.xy / 128.0);

    vec3 helper = vec3(0.0, 1.0, 0.0);
    if (dot(helper, normal) > 0.99) {
        helper = vec3(1.0, 0.0, 0.0);
    }

    vec3 tangent = normalize(cross(helper, normal));
    vec3 bitangent = cross(normal, tangent);
    float rotation = noise.r * 6.28318530718;
    float c = cos(rotation);
    float s = sin(rotation);
    mat3 tbn = mat3(
        (tangent * c) + (bitangent * s),
        (-tangent * s) + (bitangent * c),
        normal);

    float radius = ssaoPixelRadius(viewPosition, depth, vUv, uRadius);
    float falloff = max(ssaoFalloffDistance(radius), 1e-4);
    float biasHeuristic = (min(0.1, falloff * 0.1) / max(radius, 1e-4))
        * fwidth(length(viewPosition));
    float bias = uBiasOffset + (uBiasMultiplier * biasHeuristic);

    float offsetMove = noise.g;
    float offsetStep = 1.0 / float(AO_SAMPLE_COUNT);
    float occluded = 0.0;
    float totalWeight = 0.0;

    for (int index = 0; index < AO_SAMPLE_COUNT; index++) {
        float move = fract(offsetMove);
        offsetMove += offsetStep;
        vec3 samplePosition = viewPosition + (radius * move * (tbn * AO_KERNEL[index]));
        vec4 projected = rbFrame.Projection * vec4(samplePosition, 1.0);
        projected.xyz /= projected.w;
        projected.xy = (projected.xy * 0.5) + 0.5;

        bool inside = projected.w > 0.0
            && all(greaterThan(projected.xyz * (1.0 - projected.xyz), vec3(0.0)));
        if (!inside) {
            continue;
        }

        totalWeight += 1.0;
        vec2 sampleUv = clamp(projected.xy, 0.0, 1.0);
        float sampleDepth = texture(sceneDepth, sampleUv).x;
        if (sampleDepth <= 0.0) {
            continue;
        }

        vec3 sampleViewPosition = ssaoViewPosition(sampleDepth, sampleUv);
        float sampleDistance = -sampleViewPosition.z;
        float worldDistance = -samplePosition.z;
        float range = smoothstep(
            0.0,
            1.0,
            falloff / max(abs(sampleDistance - worldDistance), 1e-5));
        vec2 diff = gl_FragCoord.xy - floor(projected.xy * ssaoResolution());
        bool contributes = sampleDepth != depth
            && sampleDistance != worldDistance
            && dot(diff, diff) >= 1.0
            && sampleDistance + bias < worldDistance;
        if (contributes) {
            occluded += range;
        }
    }

    float ao = clamp(1.0 - (occluded / max(totalWeight, 1.0)), 0.0, 1.0);
    oColor = vec4(ao, (normal * 0.5) + 0.5);
}
