#include "SsaoAbi.glslinc"

// DENOISE_KERNEL and DENOISE_SAMPLE_COUNT are supplied by the variant's kernel include before this
// file. The kernel is N8AO's generateDenoiseSamples(n, 11), so each variant has its own lateral disk
// coverage and a compile-time tap bound.

layout(location = 0) in vec2 vUv;
layout(location = 0) out vec4 oColor;

void main() {
    ivec2 size = ivec2(ssaoResolution());
    ivec2 pixel = clamp(ivec2(gl_FragCoord.xy), ivec2(0), size - ivec2(1));
    float depth = texelFetch(sceneDepth, pixel, 0).x;
    vec4 data = texture(aoTexture, vUv);
    if (depth <= 0.0) {
        oColor = data;
        return;
    }

    vec3 viewPosition = ssaoViewPosition(depth, vUv);
    vec3 normal = normalize((data.gba * 2.0) - 1.0);
    float radius = ssaoPixelRadius(viewPosition, depth, vUv, uRadius);
    float falloff = max(ssaoFalloffDistance(radius), 1e-4);
    vec2 texel = 1.0 / ssaoResolution();
    vec4 noise = texture(blueNoise, gl_FragCoord.xy / 128.0);
    float angle = (uIteration == 0u ? noise.w : noise.z) * 6.28318530718;
    float c = cos(angle);
    float s = sin(angle);
    mat2 rotation = mat2(c, -s, s, c);

    float occlusion = data.r;
    float count = 1.0;
    for (int index = 0; index < DENOISE_SAMPLE_COUNT; index++) {
        vec2 offset = (rotation * DENOISE_KERNEL[index]) * texel * uDenoiseRadius;
        vec2 sampleUv = vUv + offset;
        float sampleDepth = texture(sceneDepth, sampleUv).x;
        if (sampleDepth <= 0.0) {
            continue;
        }

        vec4 sampleData = texture(aoTexture, sampleUv);
        vec3 sampleNormal = normalize((sampleData.gba * 2.0) - 1.0);
        vec3 sampleViewPosition = ssaoViewPosition(sampleDepth, sampleUv);
        float tangentPlaneDistance = abs(dot(sampleViewPosition - viewPosition, normal));
        float range = exp(-tangentPlaneDistance / falloff)
            * max(dot(normal, sampleNormal), 0.0);
        occlusion += sampleData.r * range;
        count += range;
    }

    occlusion = clamp(occlusion / max(count, 1e-4), 0.0, 1.0);
    if (occlusion == 0.0) {
        occlusion = 1.0;
    }

    oColor = vec4(occlusion, data.gba);
}
