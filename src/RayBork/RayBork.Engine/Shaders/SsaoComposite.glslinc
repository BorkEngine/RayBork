#include "SsaoAbi.glslinc"

layout(location = 0) in vec2 vUv;
layout(location = 0) out vec4 oColor;

void main() {
    vec4 scene = texture(sourceColor, vUv);
    float ao = clamp(texture(aoTexture, vUv).r, 0.0, 1.0);

    // N8AO's standard composite: pow(ao, intensity), then mix the scene color toward the tinted
    // occluded color. The tint is black by default; a brighter tint behaves like an ambient color.
    float finalAo = pow(ao, max(uIntensity, 0.0));
    vec3 aoApplied = uAoColor.rgb * scene.rgb;
    oColor = vec4(mix(scene.rgb, aoApplied, 1.0 - finalAo), scene.a);
}
