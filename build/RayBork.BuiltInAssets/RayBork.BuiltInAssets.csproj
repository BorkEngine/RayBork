<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>RayBork.BuiltInAssets</RootNamespace>
        <AssemblyName>RayBork.BuiltInAssets</AssemblyName>
        <!-- Build-time JIT tooling only: never AOT-compatible and never referenced by a runtime
             project. The generated pack is embedded as C# by RayBork.Engine's build target. -->
        <IsAotCompatible>false</IsAotCompatible>
        <PublishAot>false</PublishAot>
        <IsPackable>false</IsPackable>
        <!-- The shared GLSL compiler lives in RayBork.Bake, which is unsafe. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- The generator reuses the ordinary bake pipeline, its processors, and the shared GLSL
             compiler, so the built-in pack is produced exactly like game content. -->
        <ProjectReference Include="..\..\src\RayBork\RayBork.Bake\RayBork.Bake.csproj" />
        <ProjectReference Include="..\..\src\RayBork\RayBork.Engine\RayBork.Engine.csproj" />
    </ItemGroup>

</Project>
