<Project>

    <!--
        RayBork.BuiltInAssets.targets - build-time generation of the embedded built-in asset pack for
        RayBork.Engine.

        Import this file from RayBork.Engine.csproj. Before CoreCompile it restores and builds the
        build-only RayBork.BuiltInAssets tool out of process, runs it over the checked-in built-in
        asset sources (src/RayBork/RayBork.Engine/BuiltInAssets/Assets) with the ordinary bake
        processors, and adds the generated C# file (internal static byte array for
        raybork-builtin.pck) to this project's compilation.

        The tool is JIT and build-only. It references RayBork.Bake so it can reuse the bake pipeline
        and the shared GLSL compiler, but RayBork.Engine never references it, and neither the tool
        nor its packages enter the engine output or AOT publish graph. The generated file lives under
        the intermediate output, is never committed, and is never published as a loose pack; no
        Vulkan SDK is required.

        The generator also references RayBork.Engine, which imports this file. A nested engine build
        inside the generator build would therefore recurse. The generator build is started with
        RayBorkBuiltInAssetsEnabled=false, which turns the integration off for every project in that
        nested build and compiles a placeholder BuiltInPack instead; the outer enabled build then
        compiles the real generated pack. A build with RayBorkBuiltInAssetsEnabled=false therefore
        embeds the documented empty built-in pack.

        Incremental input: the built-in sources plus a fingerprint of the generator assembly. The
        fingerprint is a hash file rather than the assembly itself because the outer engine compile
        runs after the generator and would otherwise make the assembly look newer on every build,
        regenerating the pack forever. The fingerprint changes only when the generator content
        changes, so an unchanged build skips the generator. The generator build itself is gated on
        its own sources, the bake sources, and the engine sources so the engine's intermediate output
        timestamps do not rebuild it on every build.

        Properties:
          RayBorkBuiltInAssetsEnabled            false disables the integration
          RayBorkBuiltInAssetsProjectFile        tool project; default build/RayBork.BuiltInAssets
          RayBorkBuiltInAssetsSourceDirectory    built-in asset project root;
                                                 default src/RayBork/RayBork.Engine/BuiltInAssets
          RayBorkEngineShadersDirectory          engine present GLSL sources;
                                                 default src/RayBork/RayBork.Engine/Shaders
          RayBorkBuiltInAssetsTargetFramework    tool target framework; default net11.0
          RayBorkDotNetHost                      dotnet host; default $(DOTNET_HOST_PATH), else dotnet

        RemoveProperties keeps the consuming project's RID/publish settings off the tool restore and
        build.
    -->

    <PropertyGroup>
        <RayBorkBuiltInAssetsEnabled Condition="'$(RayBorkBuiltInAssetsEnabled)' == ''">true</RayBorkBuiltInAssetsEnabled>
        <RayBorkBuiltInAssetsProjectFile Condition="'$(RayBorkBuiltInAssetsProjectFile)' == ''">$(MSBuildThisFileDirectory)RayBork.BuiltInAssets\RayBork.BuiltInAssets.csproj</RayBorkBuiltInAssetsProjectFile>
        <RayBorkBuiltInAssetsSourceDirectory Condition="'$(RayBorkBuiltInAssetsSourceDirectory)' == ''">$(MSBuildThisFileDirectory)..\src\RayBork\RayBork.Engine\BuiltInAssets</RayBorkBuiltInAssetsSourceDirectory>
        <RayBorkEngineShadersDirectory Condition="'$(RayBorkEngineShadersDirectory)' == ''">$(MSBuildThisFileDirectory)..\src\RayBork\RayBork.Engine\Shaders</RayBorkEngineShadersDirectory>
        <RayBorkBuiltInAssetsTargetFramework Condition="'$(RayBorkBuiltInAssetsTargetFramework)' == ''">net11.0</RayBorkBuiltInAssetsTargetFramework>
        <!-- Use the SDK host that is running this build instead of whatever `dotnet` happens to be
             first on PATH. On WSL the default host can be an older runtime without net11.0. -->
        <RayBorkDotNetHost Condition="'$(RayBorkDotNetHost)' == '' and '$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</RayBorkDotNetHost>
        <RayBorkDotNetHost Condition="'$(RayBorkDotNetHost)' == ''">dotnet</RayBorkDotNetHost>
        <RayBorkBuiltInAssetsAssembly Condition="'$(RayBorkBuiltInAssetsAssembly)' == ''">$(MSBuildThisFileDirectory)RayBork.BuiltInAssets\bin\$(Configuration)\$(RayBorkBuiltInAssetsTargetFramework)\RayBork.BuiltInAssets.dll</RayBorkBuiltInAssetsAssembly>
    </PropertyGroup>

    <Target Name="RayBorkRestoreBuiltInAssets"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' != 'false' and '$(_RayBorkRestoreBuiltInAssetsCompleted)' != 'true'">
        <PropertyGroup>
            <_RayBorkRestoreBuiltInAssetsCompleted>true</_RayBorkRestoreBuiltInAssetsCompleted>
        </PropertyGroup>
        <MSBuild Projects="$(RayBorkBuiltInAssetsProjectFile)"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration);RayBorkBuiltInAssetsEnabled=false;RayBorkBuiltInAssetsNested=true"
                 RemoveProperties="RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir;BaseOutputPath;BaseIntermediateOutputPath;PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;EnableAotAnalyzer;EnableTrimAnalyzer;IsAotCompatible" />
    </Target>

    <!--
        The generator assembly is compiled against RayBork.Engine, so MSBuild would otherwise rebuild
        it every time that reference assembly changes, including after the engine recompiles the
        generated pack. The fingerprint would then change and the pack would regenerate on every
        build. The explicit input list keeps the generator build tied to the code that produces the
        pack (the tool, the bake, the engine) instead of the engine's intermediate timestamps; the
        asset sources are declared by the generate target below.
    -->
    <Target Name="RayBorkBuildBuiltInAssets"
            DependsOnTargets="RayBorkPrepareBuiltInAssets;RayBorkRestoreBuiltInAssets"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' != 'false'"
            Inputs="@(_RayBorkBuiltInAssetsToolInputs)"
            Outputs="$(RayBorkBuiltInAssetsAssembly)">
        <MSBuild Projects="$(RayBorkBuiltInAssetsProjectFile)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);RayBorkBuiltInAssetsEnabled=false;RayBorkBuiltInAssetsNested=true"
                 RemoveProperties="RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir;BaseOutputPath;BaseIntermediateOutputPath;PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;EnableAotAnalyzer;EnableTrimAnalyzer;IsAotCompatible" />
        <!-- The AfterTargets hook that normally copies libshaderc is not reliable when Build is
             invoked through the MSBuild task during another project's build, so invoke the copy
             target explicitly before the generator runs. -->
        <MSBuild Projects="$(RayBorkBuiltInAssetsProjectFile)"
                 Targets="RayBorkCopyShadercNative"
                 Properties="Configuration=$(Configuration);RayBorkBuiltInAssetsEnabled=false;RayBorkBuiltInAssetsNested=true"
                 RemoveProperties="RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir;BaseOutputPath;BaseIntermediateOutputPath;PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;EnableAotAnalyzer;EnableTrimAnalyzer;IsAotCompatible" />
        <Error Condition="!Exists('$(RayBorkBuiltInAssetsAssembly)')"
               Text="RayBork built-in assets: the tool was not produced at '$(RayBorkBuiltInAssetsAssembly)'." />
    </Target>

    <!--
        IntermediateOutputPath is computed by the SDK targets after the project body, so the generated
        paths are resolved inside a target rather than at evaluation time.
    -->
    <Target Name="RayBorkPrepareBuiltInAssets"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' != 'false'">
        <PropertyGroup>
            <!-- MSBuild does not expand a wildcard that still contains '..', so normalize the
                 configured defaults before using them in Inputs and on the tool command line. -->
            <_RayBorkBuiltInAssetsSourceRoot>$([System.IO.Path]::GetFullPath('$(RayBorkBuiltInAssetsSourceDirectory)'))</_RayBorkBuiltInAssetsSourceRoot>
            <_RayBorkBuiltInAssetsEngineShaders>$([System.IO.Path]::GetFullPath('$(RayBorkEngineShadersDirectory)'))</_RayBorkBuiltInAssetsEngineShaders>
            <_RayBorkBuiltInAssetsToolDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)RayBork.BuiltInAssets'))</_RayBorkBuiltInAssetsToolDirectory>
            <_RayBorkBuiltInAssetsBakeDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\RayBork\RayBork.Bake'))</_RayBorkBuiltInAssetsBakeDirectory>
            <_RayBorkBuiltInAssetsEngineDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\RayBork\RayBork.Engine'))</_RayBorkBuiltInAssetsEngineDirectory>
            <_RayBorkBuiltInAssetsGeneratedFile>$(IntermediateOutputPath)BuiltInAssets\BuiltInAssets.g.cs</_RayBorkBuiltInAssetsGeneratedFile>
            <_RayBorkBuiltInAssetsFingerprintFile>$(IntermediateOutputPath)BuiltInAssets\BuiltInAssets.tool.sha256</_RayBorkBuiltInAssetsFingerprintFile>
        </PropertyGroup>
        <ItemGroup>
            <!-- Every file under the built-in source tree invalidates the generated pack. -->
            <_RayBorkBuiltInAssetsInputs Include="$(_RayBorkBuiltInAssetsSourceRoot)\Assets\**\*" />
            <_RayBorkBuiltInAssetsInputs Include="$(_RayBorkBuiltInAssetsEngineShaders)\**\*.glsl" />
            <_RayBorkBuiltInAssetsToolInputs Include="$(_RayBorkBuiltInAssetsToolDirectory)\**\*"
                                             Exclude="$(_RayBorkBuiltInAssetsToolDirectory)\bin\**;$(_RayBorkBuiltInAssetsToolDirectory)\obj\**" />
            <_RayBorkBuiltInAssetsToolInputs Include="$(_RayBorkBuiltInAssetsBakeDirectory)\**\*"
                                             Exclude="$(_RayBorkBuiltInAssetsBakeDirectory)\bin\**;$(_RayBorkBuiltInAssetsBakeDirectory)\obj\**" />
            <_RayBorkBuiltInAssetsToolInputs Include="$(_RayBorkBuiltInAssetsEngineDirectory)\**\*"
                                             Exclude="$(_RayBorkBuiltInAssetsEngineDirectory)\bin\**;$(_RayBorkBuiltInAssetsEngineDirectory)\obj\**;$(_RayBorkBuiltInAssetsEngineDirectory)\BuiltInAssets\Assets\**;$(_RayBorkBuiltInAssetsEngineDirectory)\Shaders\**" />
            <_RayBorkBuiltInAssetsToolInputs Include="$(MSBuildThisFileDirectory)..\Directory.Build.props;$(MSBuildThisFileDirectory)..\Directory.Packages.props;$(MSBuildThisFileDirectory)..\global.json;$(MSBuildThisFileDirectory)RayBork.BuiltInAssets.targets" />
        </ItemGroup>
    </Target>

    <Target Name="RayBorkFingerprintBuiltInAssets"
            DependsOnTargets="RayBorkPrepareBuiltInAssets"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' != 'false'">
        <GetFileHash Files="$(RayBorkBuiltInAssetsAssembly)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_RayBorkBuiltInAssetsToolHash" />
        </GetFileHash>
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RayBorkBuiltInAssetsFingerprintFile)'))" />
        <WriteLinesToFile File="$(_RayBorkBuiltInAssetsFingerprintFile)"
                          Lines="@(_RayBorkBuiltInAssetsToolHash->'%(FileHash)')"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="RayBorkGenerateBuiltInAssets"
            DependsOnTargets="RayBorkPrepareBuiltInAssets;RayBorkBuildBuiltInAssets;RayBorkFingerprintBuiltInAssets"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' != 'false'"
            Inputs="@(_RayBorkBuiltInAssetsInputs);$(_RayBorkBuiltInAssetsFingerprintFile)"
            Outputs="$(_RayBorkBuiltInAssetsGeneratedFile)">
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RayBorkBuiltInAssetsGeneratedFile)'))" />
        <!-- Ensure libshaderc is beside the tool even when the tool build itself was up to date and
             its AfterTargets copy hook did not run. -->
        <MSBuild Projects="$(RayBorkBuiltInAssetsProjectFile)"
                 Targets="RayBorkCopyShadercNative"
                 Properties="Configuration=$(Configuration);RayBorkBuiltInAssetsEnabled=false;RayBorkBuiltInAssetsNested=true"
                 RemoveProperties="RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir;BaseOutputPath;BaseIntermediateOutputPath;PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;EnableAotAnalyzer;EnableTrimAnalyzer;IsAotCompatible" />
        <Exec Command="&quot;$(RayBorkDotNetHost)&quot; &quot;$(RayBorkBuiltInAssetsAssembly)&quot; --output &quot;$(_RayBorkBuiltInAssetsGeneratedFile)&quot; --source-root &quot;$(_RayBorkBuiltInAssetsSourceRoot)&quot; --engine-shaders &quot;$(_RayBorkBuiltInAssetsEngineShaders)&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)"
              StandardOutputImportance="high"
              StandardErrorImportance="high" />
    </Target>

    <Target Name="RayBorkIncludeBuiltInAssets"
            DependsOnTargets="RayBorkGenerateBuiltInAssets"
            BeforeTargets="CoreCompile"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' != 'false'">
        <ItemGroup>
            <Compile Include="$(_RayBorkBuiltInAssetsGeneratedFile)" Condition="Exists('$(_RayBorkBuiltInAssetsGeneratedFile)')" />
            <FileWrites Include="$(_RayBorkBuiltInAssetsGeneratedFile)" Condition="Exists('$(_RayBorkBuiltInAssetsGeneratedFile)')" />
            <FileWrites Include="$(_RayBorkBuiltInAssetsFingerprintFile)" Condition="Exists('$(_RayBorkBuiltInAssetsFingerprintFile)')" />
        </ItemGroup>
    </Target>

    <!--
        The placeholder keeps RayBork.Engine compilable while the generator itself builds (the
        generator references the engine) and when the integration is explicitly disabled. It defines
        the same BuiltInPack type with empty bytes, which is the documented empty built-in pack.

        The nested build reuses the real generated file path and only writes an empty placeholder
        when that file is missing, so both engine compilations have exactly the same compile inputs.
        Two different input lists would make MSBuild's per-project CoreCompileInputs cache alternate
        between them and recompile the engine on every build; with identical inputs the nested build
        simply reuses the previous real compilation. A written placeholder also removes the tool
        fingerprint so the outer build cannot mistake the placeholder for an up-to-date pack.
    -->
    <Target Name="RayBorkProvideBuiltInPackPlaceholder"
            BeforeTargets="CoreCompile"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' == 'false' and '$(RayBorkBuiltInAssetsNested)' == 'true'">
        <PropertyGroup>
            <_RayBorkBuiltInAssetsGeneratedFile>$(IntermediateOutputPath)BuiltInAssets\BuiltInAssets.g.cs</_RayBorkBuiltInAssetsGeneratedFile>
            <_RayBorkBuiltInAssetsFingerprintFile>$(IntermediateOutputPath)BuiltInAssets\BuiltInAssets.tool.sha256</_RayBorkBuiltInAssetsFingerprintFile>
            <_RayBorkBuiltInAssetsPlaceholderNeeded Condition="!Exists('$(_RayBorkBuiltInAssetsGeneratedFile)')">true</_RayBorkBuiltInAssetsPlaceholderNeeded>
        </PropertyGroup>
        <ItemGroup>
            <_RayBorkBuiltInAssetsPlaceholderLine Include="// &lt;auto-generated/&gt;" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="// The built-in pack generator did not run for this build%3B the embedded pack is empty." />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="namespace RayBork.Internal%3B" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="internal static class BuiltInPack {" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="    internal static byte[] Bytes => _bytes%3B" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="    private static readonly byte[] _bytes = []%3B" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="}" />
        </ItemGroup>
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RayBorkBuiltInAssetsGeneratedFile)'))" />
        <WriteLinesToFile File="$(_RayBorkBuiltInAssetsGeneratedFile)"
                          Condition="'$(_RayBorkBuiltInAssetsPlaceholderNeeded)' == 'true'"
                          Lines="@(_RayBorkBuiltInAssetsPlaceholderLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        <Delete Files="$(_RayBorkBuiltInAssetsFingerprintFile)"
                Condition="'$(_RayBorkBuiltInAssetsPlaceholderNeeded)' == 'true' and Exists('$(_RayBorkBuiltInAssetsFingerprintFile)')" />
        <ItemGroup>
            <Compile Include="$(_RayBorkBuiltInAssetsGeneratedFile)" />
            <FileWrites Include="$(_RayBorkBuiltInAssetsGeneratedFile)" />
            <FileWrites Include="$(_RayBorkBuiltInAssetsFingerprintFile)" Condition="Exists('$(_RayBorkBuiltInAssetsFingerprintFile)')" />
        </ItemGroup>
    </Target>

    <Target Name="RayBorkProvideBuiltInPackPlaceholderWhenDisabled"
            BeforeTargets="CoreCompile"
            Condition="'$(RayBorkBuiltInAssetsEnabled)' == 'false' and '$(RayBorkBuiltInAssetsNested)' != 'true'">
        <PropertyGroup>
            <_RayBorkBuiltInAssetsDisabledPlaceholderFile>$(IntermediateOutputPath)BuiltInAssets\BuiltInPack.Placeholder.g.cs</_RayBorkBuiltInAssetsDisabledPlaceholderFile>
        </PropertyGroup>
        <ItemGroup>
            <_RayBorkBuiltInAssetsPlaceholderLine Include="// &lt;auto-generated/&gt;" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="// The built-in pack generator is disabled for this build%3B the embedded pack is empty." />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="namespace RayBork.Internal%3B" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="internal static class BuiltInPack {" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="    internal static byte[] Bytes => _bytes%3B" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="    private static readonly byte[] _bytes = []%3B" />
            <_RayBorkBuiltInAssetsPlaceholderLine Include="}" />
        </ItemGroup>
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RayBorkBuiltInAssetsDisabledPlaceholderFile)'))" />
        <WriteLinesToFile File="$(_RayBorkBuiltInAssetsDisabledPlaceholderFile)"
                          Lines="@(_RayBorkBuiltInAssetsPlaceholderLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <Compile Include="$(_RayBorkBuiltInAssetsDisabledPlaceholderFile)" />
            <FileWrites Include="$(_RayBorkBuiltInAssetsDisabledPlaceholderFile)" />
        </ItemGroup>
    </Target>

</Project>
